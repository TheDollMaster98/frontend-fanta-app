rules_version = '2';

// App privata per un gruppo di amici, MA il repository è pubblico e la
// registrazione è aperta a chiunque abbia un'email: "autenticato = fidato"
// non è più un modello di minaccia accettabile, va verificato il ruolo vero
// per ogni operazione sensibile (ruoli, impostazioni lega, membership).
// Verificato con audit (29/9): senza questo, qualunque utente registrato
// poteva autopromuoversi admin di QUALSIASI lega o developer universale con
// una chiamata Firestore dalla console del browser. Le regole sotto
// fantas/{fantaId}/members e users/{userId} sono la correzione.
//
// ATTENZIONE (9/9): la versione precedente aveva una regola più stretta su
// users/{uid} che ha rotto il login in produzione (causa non isolata prima
// del rollback — vedi TODO.md). La nuova regola qui sotto NON tocca il
// flusso di login/lettura (read resta aperto, invariato) — restringe solo
// write al proprietario del documento, e lascia isDeveloper scrivibile
// liberamente una volta già true (vedi commento sulla regola). Testata con
// l'emulatore Firestore (@firebase/rules-unit-testing) PRIMA del deploy,
// non solo letta a mente.
//
// NOTA IMPORTANTE su come Firestore combina più `match` sullo stesso path:
// se un wildcard generico (es. {subpath=**}) copre anche un path già
// gestito da una regola più specifica, l'accesso è concesso se ALMENO UNA
// delle due condizioni è vera (OR, non "vince la più specifica"). Per
// questo qui sotto NON esiste un {subpath=**} generico sotto fantas/{id}:
// ogni sottocollezione è elencata a mano, altrimenti il blocco su
// auctions/members/draft verrebbe vanificato dal wildcard.
//
// ECCEZIONE (28/9), le uniche due collection-group wildcard nel file, in
// fondo: una query collectionGroup() (es. "tutte le mie membership su
// tutte le leghe", usata per sapere di quali fanta faccio parte) NON è
// coperta da una regola annidata sotto fantas/{fantaId} — quella si
// applica solo a un path con fantaId già noto, mai a una query trasversale
// a tutte le leghe. Serve una regola dedicata con {path=**}. Sono SOLO
// "allow read" (mai write), quindi non allargano nulla in OR: read era già
// aperto senza condizioni nella regola annidata corrispondente, qui si
// abilita solo la FORMA di query che Firestore richiede, non un permesso
// nuovo. Trovato con l'emulatore (rules-unit-testing): senza queste due
// regole, collectionGroup("members") e collectionGroup("joinRequests")
// tornavano permission-denied per chiunque, sempre, non per un problema di
// timing o di token.
service cloud.firestore {
  match /databases/{database}/documents {

    // Globale (non annidata sotto fantas/{fantaId} come le altre funzioni
    // qui sotto, che dipendono da $(fantaId)): serve anche a users/{userId}
    // e invites/{code}, entrambi allo stesso livello di fantas, non dentro.
    // Spostata qui il 30/9 quando è servita la prima volta fuori da
    // fantas/{fantaId} — prima era duplicata solo lì.
    function isDeveloper() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isDeveloper', false) == true;
    }

    match /users/{userId} {
      allow read: if request.auth != null;

      // Registrazione a invito (30/9): la app è per un gruppo chiuso di
      // amici ma il repo è pubblico e chiunque può creare un account
      // Firebase Auth (Firestore non può impedirlo, non governa
      // l'autenticazione) — quello che SI può impedire è la creazione del
      // profilo users/{uid}, senza il quale l'app è inutilizzabile (ogni
      // pagina della dashboard aspetta AuthContext.user, mappato da questo
      // documento). Richiede un invites/{code} valido e non ancora usato,
      // referenziato dal campo inviteCode sul documento stesso — vedi
      // invites/{code} qui sotto per come si genera/consuma. .get() con
      // default '' invece di request.resource.data.inviteCode diretto:
      // altrimenti un create senza quel campo lancerebbe un errore di
      // valutazione invece di negare in modo pulito.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('isDeveloper', false) == false
        && exists(/databases/$(database)/documents/invites/$(request.resource.data.get('inviteCode', '')))
        && get(/databases/$(database)/documents/invites/$(request.resource.data.get('inviteCode', ''))).data.usedBy == null;

      // isDeveloper (accesso developer universale a tutta l'app) è
      // IMMUTABILE da qui, in entrambe le direzioni: un self-toggle
      // "true->false->true" nella stessa sessione non è distinguibile da
      // regole senza stato da "false->true" di chi non è mai stato
      // developer (dopo il primo spegnimento il documento torna a
      // isDeveloper:false, uguale in entrambi i casi) — testato con
      // l'emulatore, la versione precedente di questa regola permetteva il
      // turn-off ma poi bloccava il turn-back-on, un bug vero trovato prima
      // del deploy. Va acceso/spento solo a mano dalla Firebase Console,
      // come diceva già il commento in AuthContext.tsx — ora è la regola a
      // farlo rispettare davvero, non solo un commento. Il toggle
      // self-service in Impostazioni smette di funzionare con questa
      // regola: è un effetto collaterale noto, non un bug.
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.get('isDeveloper', false) == resource.data.get('isDeveloper', false);
    }

    // Cache dei giocatori pro: nessuna pagina dell'app la scrive oggi
    // (8/10). Scrittura solo developer, invece di chiunque loggato.
    match /proplayers/{playerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isDeveloper();
    }

    // Link invito per la registrazione (30/9): vedi il commento su
    // users/{userId}.create per il perché. Un solo uso a testa, generati
    // solo da un developer nella sezione "Inviti" di Impostazioni.
    match /invites/{code} {
      // Server-side, non solo nascosto in UI: altrimenti chiunque
      // potrebbe autogenerarsi un invito dalla console del browser e
      // aggirare il gate sulla registrazione qui sopra.
      allow create: if request.auth != null && isDeveloper()
        && request.resource.data.usedBy == null
        && request.resource.data.createdBy == request.auth.uid;

      // Serve poter leggere il documento per validare un codice PRIMA di
      // creare il proprio users/{uid} (subito dopo l'autenticazione
      // Firebase, che non passa da qui): aperta a chiunque sia
      // autenticato, stesso schema già in uso in tutto il resto del file.
      // Non espone nulla di sensibile: solo chi l'ha usato e quando.
      allow read: if request.auth != null;

      // Consumare un invito: SOLO passare da usedBy:null a usedBy:se
      // stesso, nient'altro — non si può "rubare" un invito già usato, non
      // si può liberarlo di nuovo, non si può assegnarlo a qualcun altro.
      allow update: if request.auth != null
        && resource.data.usedBy == null
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt']);

      allow delete: if request.auth != null && isDeveloper();
    }

    match /fantas/{fantaId} {
      allow read: if request.auth != null;
      // Creare una nuova lega è self-service (bottone "Crea Nuovo Fanta"):
      // chiunque loggato può farlo, diventa admin tramite il create sotto
      // members/{creatorUid} nella stessa batch.
      allow create: if request.auth != null;
      // Modificare o cancellare una lega ESISTENTE richiede di esserne
      // admin/vice — prima non c'era nessun controllo qui, chiunque loggato
      // poteva riscrivere impostazioni/nome/inviteCode di qualunque lega.
      allow update, delete: if request.auth != null && isAdminOrVice();

      // true se la lega ha il mercato chiuso (bottone "Avvia Stagione" in
      // Gestione Lega). Assente/false = mercato aperto (default per le
      // leghe create prima di questo campo).
      function seasonStarted() {
        return get(/databases/$(database)/documents/fantas/$(fantaId))
          .data.settings.get('seasonStarted', false) == true;
      }

      // isDeveloper() è globale (vedi in cima al file, subito dentro
      // match /databases/{database}/documents): un developer (users/{uid}.
      // isDeveloper, vedi la nota su immutabilità in quella regola) ha
      // "accesso universale a tutte le leghe, senza bisogno di farne parte
      // o di essere admin" — testo letterale della UI in Impostazioni.
      // Prima di stringere le regole (29/9) questo era vero per
      // costruzione: tutto era aperto a chiunque, quindi il flag non
      // serviva lato server. Ora che isAdminOrVice/isAdmin controllano il
      // ruolo vero, un developer senza un member doc reale in quella lega
      // (o con ruolo "membro") veniva bloccato da Firestore pur vedendo i
      // pulsanti in UI — bug vero, trovato testando la creazione di
      // un'asta.

      // Ruolo di chi sta scrivendo IN QUESTA lega (non il ruolo di un
      // pick/giocatore pro, tutt'altra cosa), o developer. isDeveloper()
      // valutata PRIMA (corto circuito ||): se true, il get() sul member
      // doc — che per un developer senza membership qui non esiste — non
      // viene mai eseguito. Se l'utente non è membro né developer, quel
      // get() fallisce e la funzione valuta false (comportamento
      // documentato di Firestore Rules: un get()/exists() che fallisce
      // nega, non va in errore verso il client).
      function isAdminOrVice() {
        return isDeveloper() || (
          exists(/databases/$(database)/documents/fantas/$(fantaId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/fantas/$(fantaId)/members/$(request.auth.uid)).data.role in ['admin', 'vice']
        );
      }

      // Come isAdminOrVice ma solo admin (o developer): gestione membri
      // (cacciare, promuovere/rimuovere vice) resta una decisione del
      // creatore, non dei vice — stesso identico vincolo già imposto lato
      // UI (canManageMembers = isFantaAdmin in
      // app/dashboard/admin/page.tsx).
      function isAdmin() {
        return isDeveloper() || (
          exists(/databases/$(database)/documents/fantas/$(fantaId)/members/$(request.auth.uid))
          && get(/databases/$(database)/documents/fantas/$(fantaId)/members/$(request.auth.uid)).data.role == 'admin'
        );
      }

      // Qualunque membro della lega (o developer), a prescindere dal ruolo:
      // usata da auctions/create (30/9) perché avviare un'asta è aperto a
      // tutti i membri, non solo admin/vice — decisione prodotto, distinta
      // da isAdminOrVice() che resta per le azioni di gestione (chiudere,
      // annullare, assegnare manualmente un'asta già avviata).
      function isMember() {
        return isDeveloper()
          || exists(/databases/$(database)/documents/fantas/$(fantaId)/members/$(request.auth.uid));
      }

      match /members/{memberId} {
        allow read: if request.auth != null;

        // Due soli casi legittimi di creazione, nessun altro:
        // 1) bootstrap: chi ha appena creato la lega (fantas/create sopra,
        //    stessa batch) si auto-nomina admin — permesso SOLO se è
        //    davvero lui il creatore dichiarato sul documento fanta
        //    (createdBy, scritto una volta in FantaContext.addFanta), mai
        //    per una lega già esistente con un altro creatore.
        // 2) approvazione di una richiesta d'ingresso: un admin/vice crea
        //    il membro per conto del richiedente (approveJoinRequest),
        //    sempre e solo come "membro" semplice, mai admin/vice.
        // Prima non c'era ALCUN controllo qui: chiunque loggato poteva
        // scriversi "role: admin" in qualsiasi lega, anche non sua.
        allow create: if request.auth != null && (
          (
            request.auth.uid == memberId
            && request.resource.data.role == 'admin'
            && get(/databases/$(database)/documents/fantas/$(fantaId)).data.get('createdBy', '') == request.auth.uid
          )
          || (isAdminOrVice() && request.resource.data.role == 'membro')
          // 3) ingresso da link invito della lega (/join/{code}, 8/10):
          //    prima mancava e chiunque aprisse il link riceveva
          //    permission-denied. Solo se stessi, solo "membro", con il
          //    codice invito attuale della lega (joinCode sul documento) e
          //    una rosa vuota col budget di partenza della lega — niente
          //    budget gonfiati o giocatori già in rosa all'ingresso.
          || (
            request.auth.uid == memberId
            && request.resource.data.role == 'membro'
            && request.resource.data.get('joinCode', '') != ''
            && request.resource.data.get('joinCode', '') == get(/databases/$(database)/documents/fantas/$(fantaId)).data.get('inviteCode', '')
            && request.resource.data.team.size() == 0
            && request.resource.data.budgetSpent == 0
            && request.resource.data.budgetTot == get(/databases/$(database)/documents/fantas/$(fantaId)).data.get('settings', {}).get('generalBudget', 0)
            && request.resource.data.budgetLeft == request.resource.data.budgetTot
          )
        );

        // Rimuovere un membro è un'azione da admin (non vice, vedi isAdmin
        // sopra) — prima chiunque loggato poteva cacciare chiunque da
        // qualunque lega.
        allow delete: if request.auth != null && isAdmin();

        function isRoleChange() {
          return request.resource.data.role != resource.data.role;
        }

        // Budget coerente (8/10): budgetTot fisso, quanto scende budgetLeft
        // tanto sale budgetSpent (e viceversa), mai spesa negativa, e
        // budgetLeft mai oltre il budget totale (o oltre il valore che
        // aveva già, se un admin l'aveva alzato).
        function budgetConsistent() {
          let before = resource.data;
          let after = request.resource.data;
          return after.get('budgetTot', 0) == before.get('budgetTot', 0)
            && after.get('budgetLeft', 0) - before.get('budgetLeft', 0)
              == before.get('budgetSpent', 0) - after.get('budgetSpent', 0)
            && after.get('budgetSpent', 0) >= 0
            && (
              after.get('budgetLeft', 0) <= after.get('budgetTot', 0)
              || after.get('budgetLeft', 0) <= before.get('budgetLeft', 0)
            );
        }

        // Svincolo di UN proprio giocatore a mercato aperto
        // (removePlayerFromTeam): la rosa nuova è quella vecchia meno
        // esattamente un pick, e il rimborso è esattamente il suo prezzo.
        // Prima "rosa che si accorcia" bastava: si poteva togliere un pick
        // da 1 credito e rimborsarsene 200, o sostituire pick mentre se ne
        // toglieva uno.
        function isSingleRelease() {
          let before = resource.data.get('team', []);
          let after = request.resource.data.get('team', []);
          let removed = before.removeAll(after);
          return request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['team', 'budgetSpent', 'budgetLeft'])
            && after.size() == before.size() - 1
            && before.hasAll(after)
            && removed.size() == 1
            && budgetConsistent()
            && resource.data.get('budgetSpent', 0) - request.resource.data.get('budgetSpent', 0)
              == removed[0].get('purchasePrice', 0);
        }

        // Rose scrivibili solo da server e admin/vice (10/10). Prima un
        // membro normale poteva far crescere qualunque rosa, propria o
        // altrui, perché asta chiusa e pick di draft venivano assegnate dal
        // browser di chi era connesso: dalla console ci si aggiungeva
        // giocatori finti. Ora quelle assegnazioni le fanno le Cloud
        // Functions (closeAuction, makeDraftPick, job delle aste), che non
        // passano da queste regole.
        // Admin/vice/developer: liberi (ricalcolo punti, statistiche
        // manuali, assegnazioni a mano, correzioni di rosa). Membro
        // normale: solo sul proprio documento, solo il nome squadra o lo
        // svincolo di un giocatore a mercato aperto.
        allow update: if request.auth != null && isMember() && (
          (isRoleChange() && isAdmin())
          || (!isRoleChange() && isAdminOrVice())
          || (
            request.auth.uid == memberId
            && (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teamName'])
              || (!seasonStarted() && isSingleRelease())
            )
          )
        );
      }

      match /auctions/{auctionId} {
        allow read: if request.auth != null;

        // Annullare un'asta è admin/vice lato UI (cancelAuction) — prima
        // chiunque loggato poteva cancellare l'asta di qualunque lega.
        allow delete: if request.auth != null && isAdminOrVice();

        // Creare un'asta è aperto a qualunque membro della lega (30/9,
        // decisione prodotto: "faccia creare le aste a tutti"), non solo
        // admin/vice — ma resta comunque riservato a chi è DAVVERO membro
        // di QUESTA lega (isMember()), mai a un utente qualsiasi loggato
        // che potrebbe altrimenti spammare aste in leghe altrui. Niente
        // nuove aste comunque una volta chiuso il mercato, admin incluso
        // (chi deve sistemare qualcosa usa l'assegnazione manuale su aste
        // già esistenti, non serve crearne altre).
        allow create: if request.auth != null && !seasonStarted() && isMember();

        // Offerta valida (9/10): prima il prezzo era controllato solo dal
        // client, e dalla console si poteva scrivere qualunque prezzo o
        // mettere un altro membro come offerente. Ora un'offerta di un
        // membro normale deve: essere a proprio nome, alzare il prezzo, su
        // un'asta attiva, entro la puntata massima della lega e entro il
        // proprio budget rimanente, toccando solo i campi di un'offerta. La
        // riserva per i posti rosa ancora da riempire resta un controllo
        // del client (servirebbe contare la rosa, qui non è proporzionato).
        function isValidBid() {
          let settings = get(/databases/$(database)/documents/fantas/$(fantaId)).data.get('settings', {});
          let bidder = get(/databases/$(database)/documents/fantas/$(fantaId)/members/$(request.auth.uid)).data;
          return request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['currentPrice', 'highestBidderId', 'highestBidderName', 'countdownEndsAt', 'updatedAt'])
            && resource.data.status == 'active'
            && request.resource.data.highestBidderId == request.auth.uid
            && request.resource.data.currentPrice > resource.data.currentPrice
            && request.resource.data.currentPrice <= settings.get('maxBid', 1000000000)
            && request.resource.data.currentPrice <= bidder.get('budgetLeft', 0);
        }

        // Admin/vice/developer liberi (avvio, pausa, chiusura,
        // assegnazioni a mano, riaperture: tutti bottoni solo loro in UI).
        // Un membro normale può solo fare un'offerta valida a mercato
        // aperto (10/10): prima qualunque modifica che non toccasse il
        // prezzo era permessa, compreso mettersi come miglior offerente
        // senza rilanciare o chiudere un'asta prima della fine. La
        // chiusura allo scadere la fa il server (closeAuction).
        allow update: if request.auth != null && isMember() && (
          isAdminOrVice()
          || (!seasonStarted() && isValidBid())
        );

        match /bids/{bidId} {
          allow read: if request.auth != null;
          allow write: if request.auth != null && isMember();
        }
      }

      match /draft/{docId} {
        allow read: if request.auth != null;

        // Come le aste: resettare/cancellare il draft è admin/vice lato
        // UI, prima non c'era alcun vincolo qui.
        allow delete: if request.auth != null && isAdminOrVice();

        // Avviare un draft è già un'azione admin/vice lato UI, stesso
        // discorso delle aste: solo admin/vice possono crearlo, e comunque
        // mai a mercato chiuso.
        allow create: if request.auth != null && !seasonStarted() && isAdminOrVice();

        // Unica scrittura di un membro normale sul draft (10/10): saltare
        // un turno già scaduto (skipDraftTurn, dal browser di chiunque sia
        // connesso, come prima). Turno avanzato di uno, una voce in più tra
        // le assegnazioni in sospeso, nient'altro. La pick del proprio
        // turno la fa il server (makeDraftPick), quindi un membro non può
        // più far avanzare il draft a piacere né saltare turni non scaduti.
        function isExpiredSkip() {
          let before = resource.data;
          let after = request.resource.data;
          return request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'currentSlotIndex', 'currentTurnIndex', 'pickDeadline', 'pendingAssignments', 'updatedAt'])
            && before.status == 'active'
            && before.pickDeadline < request.time
            && after.get('pendingAssignments', []).size() == before.get('pendingAssignments', []).size() + 1
            && (
              (after.currentSlotIndex == before.currentSlotIndex
                && after.currentTurnIndex == before.currentTurnIndex + 1)
              || (after.currentSlotIndex == before.currentSlotIndex + 1
                && after.currentTurnIndex == 0)
            );
        }

        allow update: if request.auth != null && (
          isAdminOrVice()
          || (isMember() && isExpiredSkip())
        );
      }

      // Storico acquisti: scritto dal server (asta chiusa, pick di draft)
      // o da admin/vice (assegnazioni a mano). Prima qualunque membro,
      // perché quelle scritture partivano dal suo browser (10/10).
      match /history/{entryId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isAdminOrVice();
      }

      // Calendario, gironi e tabellone: generati e ricalcolati solo da
      // admin/vice/developer (Classifica, Gestione Lega → Avvia
      // Stagione). Prima chiunque loggato, anche non membro, poteva
      // riscrivere punteggi o vincitori di qualunque lega (8/10).
      match /calendar/{roundId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isAdminOrVice();
      }

      match /groups/{groupId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isAdminOrVice();
      }

      match /bracket/{roundId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isAdminOrVice();
      }

      // Pick'em (1/10): un solo documento "bracket" (scritto solo da
      // admin/vice/developer, incluso il campo locked) + un documento
      // "prediction_{uid}" per ogni membro (scrivibile solo dal membro
      // stesso, e solo finché bracket.locked non è true — una volta
      // bloccato, i pronostici non sono più modificabili da nessuno,
      // nemmeno dal proprietario). exists() prima di get() perché il
      // bracket potrebbe non esistere ancora quando un membro prova a
      // salvare la primissima bozza del proprio pronostico.
      match /pickem/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && (
          (docId == "bracket" && isAdminOrVice())
          || (
            docId == "prediction_" + request.auth.uid
            && isMember()
            && (
              !exists(/databases/$(database)/documents/fantas/$(fantaId)/pickem/bracket)
              || get(/databases/$(database)/documents/fantas/$(fantaId)/pickem/bracket).data.locked != true
            )
          )
        );
      }

      // Pick/ban campione settimanale (1/10). Stato del turno (closed):
      // solo admin/vice/developer lo scrive, chiunque autenticato lo
      // legge (serve a tutti per sapere se un turno è ancora "al buio").
      match /championPickRounds/{roundId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && isAdminOrVice();
      }

      // Un pick per (turno, membro): docId "{roundId}_{userId}" — né un
      // id auto-generato Firestore né uno uid Firebase Auth contengono
      // mai "_", quindi split('_') su due soli pezzi è sicuro. Lettura:
      // sempre il proprietario, chiunque altro SOLO dopo che il turno è
      // stato chiuso (altrimenti si vedrebbe la scelta altrui prima che
      // il turno sia stato giocato, vanificando lo scommettere "alla
      // cieca" — qui la regola stessa nega la lettura, non è un filtro
      // lato UI). Scrittura dal proprietario solo mentre il turno non è
      // ancora chiuso (dopo, il pick resta fissato per calcolare punti
      // su un valore stabile); admin/vice può sempre scrivere, serve per
      // assegnare "points" in chiusura di turno.
      //
      // get e list separati (8/10, code review): le regole NON filtrano i
      // risultati di una query. Una query (collection intera, o where
      // roundId) contro la vecchia regola basata sull'id del documento
      // veniva negata per intero, per tutti — il listener dei pick e la
      // chiusura turno non funzionavano. Ora:
      // - get (un documento per id): regola originale per id, usata dalla
      //   chiusura turno per leggere il pick di ogni membro;
      // - list (query): solo i propri (where userId == me) o quelli già
      //   rivelati (where revealed == true, scritto dalla chiusura turno).
      //   Condizioni sui campi che la query stessa vincola, quindi
      //   verificabili da Firestore. Nessuna eccezione admin sulle query:
      //   resta impossibile sbirciare le scelte altrui prima della
      //   chiusura, anche per chi chiude il turno.
      match /championPicks/{pickDocId} {
        allow get: if request.auth != null && (
          pickDocId.split('_')[1] == request.auth.uid
          || (
            exists(/databases/$(database)/documents/fantas/$(fantaId)/championPickRounds/$(pickDocId.split('_')[0]))
            && get(/databases/$(database)/documents/fantas/$(fantaId)/championPickRounds/$(pickDocId.split('_')[0])).data.closed == true
          )
        );
        allow list: if request.auth != null && (
          resource.data.userId == request.auth.uid
          || resource.data.revealed == true
        );
        allow create, update: if request.auth != null && (
          isAdminOrVice()
          || (
            pickDocId.split('_')[1] == request.auth.uid
            && request.resource.data.userId == request.auth.uid
            // "revealed" lo scrive solo la chiusura turno.
            && request.resource.data.get('revealed', false) == false
            // Solo prima della fine del turno (9/10): prima il blocco
            // era solo nell'interfaccia, e dalla console si poteva
            // scegliere a turno finito, cioè a risultati noti. Il turno
            // Pick/Ban ha lo stesso id del turno di calendario, o del turno
            // del tabellone nelle leghe Mondiali/MSI (11/10,
            // lib/pickBanRounds.ts).
            && (
              !exists(/databases/$(database)/documents/fantas/$(fantaId)/calendar/$(pickDocId.split('_')[0]))
              || get(/databases/$(database)/documents/fantas/$(fantaId)/calendar/$(pickDocId.split('_')[0])).data.endDate > request.time
            )
            && (
              !exists(/databases/$(database)/documents/fantas/$(fantaId)/bracket/$(pickDocId.split('_')[0]))
              || get(/databases/$(database)/documents/fantas/$(fantaId)/bracket/$(pickDocId.split('_')[0])).data.endDate > request.time
            )
            && (
              !exists(/databases/$(database)/documents/fantas/$(fantaId)/championPickRounds/$(pickDocId.split('_')[0]))
              || get(/databases/$(database)/documents/fantas/$(fantaId)/championPickRounds/$(pickDocId.split('_')[0])).data.closed != true
            )
          )
        );
        allow delete: if request.auth != null && isAdminOrVice();
      }

      match /joinRequests/{requestId} {
        allow read: if request.auth != null;
        // Si può creare una richiesta solo come se stessi, non a nome di
        // qualcun altro (prima chiunque poteva scrivere userId di un altro
        // utente in una richiesta e farla approvare a suo nome).
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        // Approvare/rifiutare è admin/vice lato UI — prima chiunque poteva
        // auto-approvarsi o cancellare la richiesta di qualcun altro.
        allow update, delete: if request.auth != null && isAdminOrVice();
      }
    }

    // Collection-group, vedi la nota in cima al file: solo "read", solo per
    // abilitare le query collectionGroup() che l'app fa davvero
    // (allMemberships e myJoinRequests in FantaContext.tsx).
    match /{path=**}/members/{memberId} {
      allow read: if request.auth != null;
    }

    match /{path=**}/joinRequests/{requestId} {
      allow read: if request.auth != null;
    }
  }
}
