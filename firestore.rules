rules_version = '2';

// App privata per un gruppo di amici: chiunque sia autenticato è considerato
// fidato, quindi non replichiamo qui tutta la logica di membership/ruoli già
// applicata lato client. L'unico requisito è essere loggati: niente accesso
// anonimo da chi trova solo il projectId, e niente scadenza a tempo.
//
// ATTENZIONE (9/9): la versione precedente aveva una regola più stretta su
// users/{uid} che ha rotto il login in produzione (causa non isolata prima
// del rollback — vedi TODO.md). Questa volta users/{uid} resta IDENTICO
// alla versione di rollback (blanket, invariato) apposta per non toccare
// quel codice non ancora capito: le uniche regole nuove sono sotto
// fantas/{fantaId}, testate con l'emulatore Firestore (@firebase/
// rules-unit-testing) PRIMA del deploy, non solo lette a mente.
//
// NOTA IMPORTANTE su come Firestore combina più `match` sullo stesso path:
// se un wildcard generico (es. {subpath=**}) copre anche un path già
// gestito da una regola più specifica, l'accesso è concesso se ALMENO UNA
// delle due condizioni è vera (OR, non "vince la più specifica"). Per
// questo qui sotto NON esiste un {subpath=**} generico sotto fantas/{id}:
// ogni sottocollezione è elencata a mano, altrimenti il blocco su
// auctions/members/draft verrebbe vanificato dal wildcard.
//
// ECCEZIONE (28/9), le uniche due collection-group wildcard nel file, in
// fondo: una query collectionGroup() (es. "tutte le mie membership su
// tutte le leghe", usata per sapere di quali fanta faccio parte) NON è
// coperta da una regola annidata sotto fantas/{fantaId} — quella si
// applica solo a un path con fantaId già noto, mai a una query trasversale
// a tutte le leghe. Serve una regola dedicata con {path=**}. Sono SOLO
// "allow read" (mai write), quindi non allargano nulla in OR: read era già
// aperto senza condizioni nella regola annidata corrispondente, qui si
// abilita solo la FORMA di query che Firestore richiede, non un permesso
// nuovo. Trovato con l'emulatore (rules-unit-testing): senza queste due
// regole, collectionGroup("members") e collectionGroup("joinRequests")
// tornavano permission-denied per chiunque, sempre, non per un problema di
// timing o di token.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if request.auth != null;
    }

    match /proplayers/{playerId} {
      allow read, write: if request.auth != null;
    }

    match /fantas/{fantaId} {
      allow read, write: if request.auth != null;

      // true se la lega ha il mercato chiuso (bottone "Avvia Stagione" in
      // Gestione Lega). Assente/false = mercato aperto (default per le
      // leghe create prima di questo campo).
      function seasonStarted() {
        return get(/databases/$(database)/documents/fantas/$(fantaId))
          .data.settings.get('seasonStarted', false) == true;
      }

      // Ruolo di chi sta scrivendo IN QUESTA lega (non il ruolo di un
      // pick/giocatore pro, tutt'altra cosa). Se l'utente non è membro di
      // questa lega, get() fallisce e la funzione chiamante valuta false
      // (comportamento documentato di Firestore Rules: un get()/exists()
      // che fallisce nega, non va in errore verso il client).
      function isAdminOrVice() {
        let role = get(
          /databases/$(database)/documents/fantas/$(fantaId)/members/$(request.auth.uid)
        ).data.role;
        return role == 'admin' || role == 'vice';
      }

      match /members/{memberId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null;

        // Il team di un membro cresce quando un'asta si chiude o parte una
        // pick di draft — scritture che possono arrivare dal browser di
        // QUALSIASI membro connesso (nessun cron/Cloud Function in
        // quest'app, vedi i commenti in FantaContext.tsx), non solo
        // dall'admin o dal proprietario. Bloccare quello romperebbe
        // l'assegnazione automatica. L'unica cosa che blocchiamo a mercato
        // chiuso è un membro normale che TOGLIE un proprio giocatore
        // (team che si accorcia): admin/vice restano liberi di farlo per
        // sistemare rose.
        function isTeamShrinking() {
          return ('team' in request.resource.data) && ('team' in resource.data)
            && request.resource.data.team.size() < resource.data.team.size();
        }

        allow update: if request.auth != null && (
          !seasonStarted()
          || isAdminOrVice()
          || !isTeamShrinking()
        );
      }

      match /auctions/{auctionId} {
        allow read: if request.auth != null;
        allow delete: if request.auth != null;

        // Creare un'asta è già un'azione admin/vice lato UI (bottone "Crea
        // Nuova Asta"): lo stesso vincolo va imposto anche qui, altrimenti
        // un membro normale potrebbe crearne una da console del browser.
        // Niente nuove aste comunque una volta chiuso il mercato, admin
        // incluso (chi deve sistemare qualcosa usa l'assegnazione manuale
        // su aste già esistenti, non serve crearne altre).
        allow create: if request.auth != null && !seasonStarted() && isAdminOrVice();

        // currentPrice cambia SOLO con un'offerta (placeBid): avvio/pausa/
        // chiusura/annullamento/assegnazione manuale di un'asta non lo
        // toccano mai, quindi restano sempre permessi. Un'offerta vera a
        // mercato chiuso è permessa solo ad admin/vice.
        function isPriceChange() {
          return request.resource.data.currentPrice != resource.data.currentPrice;
        }

        allow update: if request.auth != null && (
          !seasonStarted()
          || isAdminOrVice()
          || !isPriceChange()
        );

        match /bids/{bidId} {
          allow read, write: if request.auth != null;
        }
      }

      match /draft/{docId} {
        allow read: if request.auth != null;
        allow delete: if request.auth != null;

        // Avviare un draft è già un'azione admin/vice lato UI, stesso
        // discorso delle aste: solo admin/vice possono crearlo, e comunque
        // mai a mercato chiuso.
        allow create: if request.auth != null && !seasonStarted() && isAdminOrVice();

        // Turno atteso ricavato dagli stessi dati usati lato client
        // (lib/draft.ts#getDraftTurnUserId): a giro pari l'ordine è in
        // avanti, a giro dispari invertito. Se il documento non ha ancora
        // un ordine (stato iniziale teorico) l'espressione fallisce e la
        // funzione chiamante nega, comportamento accettabile qui.
        function expectedTurnUserId() {
          let order = resource.data.order;
          let slotIndex = resource.data.currentSlotIndex;
          let turnIndex = resource.data.currentTurnIndex;
          let forward = slotIndex % 2 == 0;
          return forward
            ? order[turnIndex]
            : order[order.size() - 1 - turnIndex];
        }

        // Blocca il caso "l'utente di turno sta facendo la propria pick"
        // quando il mercato è chiuso: uno skip per timeout innescato da un
        // client qualsiasi (non necessariamente l'utente di turno) resta
        // permesso, altrimenti romperebbe lo stesso meccanismo "nessun
        // cron" già usato per le aste.
        function isSelfPickAttempt() {
          return resource.data.status == 'active'
            && request.auth.uid == expectedTurnUserId();
        }

        // L'ordine dei turni si scrive una volta sola, all'avvio del
        // draft (startDraft, già ristretto ad admin/vice sopra): nessuna
        // pick o skip legittimi lo toccano mai, quindi un cambio di
        // `order` fuori da un create è sempre e solo un reset totale del
        // draft. Va permesso ad admin/vice (possono aver bisogno di
        // rifarlo da capo) ma mai a un membro normale, a prescindere dal
        // mercato — non è la stessa cosa del lock stagione, è integrità
        // dei dati.
        function isOrderChange() {
          return request.resource.data.order != resource.data.order;
        }

        allow update: if request.auth != null && (
          isAdminOrVice()
          || (
            !isOrderChange()
            && (!seasonStarted() || !isSelfPickAttempt())
          )
        );
      }

      match /history/{entryId} {
        allow read, write: if request.auth != null;
      }

      match /calendar/{roundId} {
        allow read, write: if request.auth != null;
      }

      match /groups/{groupId} {
        allow read, write: if request.auth != null;
      }

      match /bracket/{roundId} {
        allow read, write: if request.auth != null;
      }

      match /joinRequests/{requestId} {
        allow read, write: if request.auth != null;
      }
    }

    // Collection-group, vedi la nota in cima al file: solo "read", solo per
    // abilitare le query collectionGroup() che l'app fa davvero
    // (allMemberships e myJoinRequests in FantaContext.tsx).
    match /{path=**}/members/{memberId} {
      allow read: if request.auth != null;
    }

    match /{path=**}/joinRequests/{requestId} {
      allow read: if request.auth != null;
    }
  }
}
