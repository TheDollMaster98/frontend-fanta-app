rules_version = '2';

// App privata per un gruppo di amici: chiunque sia autenticato è considerato
// fidato, quindi non replichiamo qui tutta la logica di membership/ruoli già
// applicata lato client. L'unico requisito è essere loggati: niente accesso
// anonimo da chi trova solo il projectId, e niente scadenza a tempo.
//
// ATTENZIONE: rollback di emergenza (9/9) da una versione più stretta che
// bloccava isDeveloper (vedi commit 43d8d81) perché in produzione dava
// permission-denied su TUTTI i listener, non solo su users/{uid} — causa
// esatta non ancora isolata (il sospetto principale è come Firestore
// combina più `match` sullo stesso path quando uno ha `get()` con default,
// ma non è ancora confermato). Finché non trovo il bug la escalation
// isDeveloper (autopromozione ad admin scrivendo isDeveloper=true dalla
// console del browser) è di nuovo aperta: vedi TODO.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
