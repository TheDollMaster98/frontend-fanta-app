{
  // Example (Standard Edition):
  //
  // "indexes": [
  //   {
  //     "collectionGroup": "widgets",
  //     "queryScope": "COLLECTION",
  //     "fields": [
  //       { "fieldPath": "foo", "arrayConfig": "CONTAINS" },
  //       { "fieldPath": "bar", "mode": "DESCENDING" }
  //     ]
  //   },
  //
  //  "fieldOverrides": [
  //    {
  //      "collectionGroup": "widgets",
  //      "fieldPath": "baz",
  //      "indexes": [
  //        { "order": "ASCENDING", "queryScope": "COLLECTION" }
  //      ]
  //    },
  //   ]
  // ]
  //
  // Example (Enterprise Edition):
  //
  // "indexes": [
  //   {
  //     "collectionGroup": "reviews",
  //     "queryScope": "COLLECTION_GROUP",
  //     "apiScope": "MONGODB_COMPATIBLE_API",
  //     "density": "DENSE",
  //     "multikey": false,
  //     "fields": [
  //       { "fieldPath": "baz", "mode": "ASCENDING" }
  //     ]
  //   },
  //   {
  //     "collectionGroup": "items",
  //     "queryScope": "COLLECTION_GROUP",
  //     "apiScope": "MONGODB_COMPATIBLE_API",
  //     "density": "SPARSE_ANY",
  //     "multikey": true,
  //     "fields": [
  //       { "fieldPath": "baz", "mode": "ASCENDING" }
  //     ]
  //   },
  // ]
  // Con lo schema a sottocollezioni (fantas/{id}/auctions, fantas/{id}/auctions/{id}/bids,
  // fantas/{id}/history) le query sono già scoperte al singolo fanta dal path stesso: bastano
  // gli indici automatici a campo singolo di Firestore, niente indici composti "COLLECTION" qui.
  // Serve invece che Firestore indicizzi "userId" anche in ambito collection-group, per la
  // query "le mie richieste di ingresso" (collectionGroup(joinRequests) where userId == ...)
  // che attraversa le sottocollezioni di tutte le leghe. Essendo un solo campo, va dichiarato
  // come "single field index control" (fieldOverrides), non come indice composto in "indexes":
  // Firestore rifiuta un indice composto con un solo campo ("this index is not necessary,
  // configure using single field index controls").
  // Unico indice composto (9/10): la Cloud Function closeExpiredAuctionsJob
  // cerca su tutte le leghe le aste attive col countdown scaduto
  // (collectionGroup auctions, status == active, countdownEndsAt <= ora).
  "indexes": [
    {
      "collectionGroup": "auctions",
      "queryScope": "COLLECTION_GROUP",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "countdownEndsAt", "order": "ASCENDING" }
      ]
    }
  ],
  "fieldOverrides": [
    {
      "collectionGroup": "joinRequests",
      "fieldPath": "userId",
      "indexes": [{ "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" }]
    }
  ]
}